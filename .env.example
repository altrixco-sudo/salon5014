# ---------------------------------------------------------------
# Salon 5014 — AI Front Desk environment variables
#
# The site runs fully in DEMO MODE without any of these values.
# Demo mode powers the AI chat, lead capture, booking simulation
# and dashboard using a local knowledge base + local storage only.
#
# NEVER commit real credentials. Only connect integrations when
# they are actually configured on the server side.
# ---------------------------------------------------------------

# Optional AI provider key for server-side /api/front-desk replies.
# When empty, the API route answers from the local Salon 5014
# knowledge base (Demo Mode).
AI_API_KEY=

# External booking provider (e.g. Vagaro / Calendly / Wix Bookings).
# When empty, /book runs its polished simulated booking flow.
BOOKING_URL=

# Omnichannel connectors (not live in this demo).
INSTAGRAM_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
EMAIL_API_KEY=

# Public contact numbers/identifiers shown to guests.
NEXT_PUBLIC_SALON_PHONE=4694264308
NEXT_PUBLIC_SALON_INSTAGRAM=https://www.instagram.com/salon5014/
